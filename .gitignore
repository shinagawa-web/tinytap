# Build artifacts
/tinytap
/tinytap-e2e
/tinytap-ngx-e2e
/tinytap-soak

# GoReleaser local build output (`goreleaser release --snapshot --clean`)
/dist/

# Claude Code local settings (track shared settings.json, ignore the rest)
.claude/*
!.claude/settings.json

# Python compat server scratch (venvs, bytecode caches)
__pycache__/
*.pyc
.venv-compat/

# nginx docker-compose e2e scratch (#178): self-signed cert + per-run image
# selection, generated fresh by scripts/test-e2e-nginx.sh every run.
scripts/docker/nginx-tls/certs/*.pem
scripts/docker/nginx-tls/.env

# bpf2go-generated bindings (#260): regenerated by `make generate` (clang-17
# + libbpf 1.6.2, see .github/actions/setup-bpf-toolchain) rather than
# committed. gen.go stays tracked — it's the hand-written source that drives
# generation, not output.
internal/loader/bpf/*_bpfel.go
internal/loader/bpf/*_bpfeb.go
internal/loader/bpf/*.o
internal/loader/bpf/fixture/*_bpfel.go
internal/loader/bpf/fixture/*_bpfeb.go
internal/loader/bpf/fixture/*.o

# Hugo docs site (see #264). Theme is not vendored or a submodule (matching
# gomarklint's docs/ setup) — clone it yourself for local preview:
#   git clone --branch v13 --depth 1 https://github.com/alex-shpak/hugo-book site/themes/hugo-book
# .github/workflows/pages.yml clones it fresh again at deploy time.
site/themes/
site/public/
site/resources/
site/.hugo_build.lock
